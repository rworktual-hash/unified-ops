# Backend
# Port 3307 avoids conflict if another MariaDB already uses 3306 (see docker-compose.yml)
DATABASE_URL=mysql+pymysql://unified_ops:unified_ops_dev@127.0.0.1:3307/unified_ops
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# SSH — private keys never in Git. Local: credentials/ after generate-unified-ops-ssh-key.sh
# Production (nlp-sm): CREDENTIAL_GPU_KEY_1_PATH=/root/.ssh/id_rsa
# Target SSH is often port 4204 (not 22) — see docs/SSH_PORTS_AND_PRODUCTION.md
CREDENTIAL_GPU_KEY_1_PATH=/absolute/path/to/credentials/unified_ops_ed25519
# DEFAULT_SSH_PRIVATE_KEY_PATH=/absolute/path/to/credentials/unified_ops_ed25519
SSH_CONNECT_TIMEOUT=15
SSH_COMMAND_TIMEOUT=10
# false = accept new host keys (typical until all targets are known)
SSH_STRICT_HOST_KEYS=false
SSH_GPU_COMMAND_TIMEOUT=30

# Phase 3 — Redis / Celery (default uses local Redis on 6379)
REDIS_URL=redis://127.0.0.1:6379/0
METRICS_COLLECT_INTERVAL_SECONDS=300

# Phase 4 — alert thresholds
ALERT_MEM_USED_PCT_WARNING=85
ALERT_DISK_USED_PCT_WARNING=85
ALERT_DISK_USED_PCT_CRITICAL=92
ALERT_GPU_TEMP_C_WARNING=85

# Phase 6 — comma-separated systemd units allowed for systemctl_restart (empty = disabled)
ALLOWLIST_RESTART_SERVICES=

# Worktual Gemma (OpenAI-compatible on GPU host)
LLM_MODEL=worktual-gemma
LLM_BASE_URL=http://173.234.75.166:8011/v1
LLM_API_KEY=dummy
LLM_TIMEOUT_SECONDS=120

# Dashboard login (production: set strong JWT_SECRET; never commit passwords)
AUTH_ENABLED=true
JWT_SECRET=generate-a-long-random-string
JWT_EXPIRE_MINUTES=10080
# Optional one-time bootstrap if app_users is empty (prefer scripts/create-admin-user.py on server):
# BOOTSTRAP_ADMIN_EMAIL=you@gmail.com
# BOOTSTRAP_ADMIN_PASSWORD=

# Frontend (optional, for Vite)
# VITE_API_URL=http://localhost:8000

# GPU 165/166: set password on server only (never commit):
# SSH_GPU_PASSWORD='...' python scripts/set-gpu-ssh-password.py
