# Backend
# Port 3307 avoids conflict if another MariaDB already uses 3306 (see docker-compose.yml)
DATABASE_URL=mysql+pymysql://unified_ops:unified_ops_dev@127.0.0.1:3307/unified_ops
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# SSH — private keys never in Git. Local: credentials/ after generate-unified-ops-ssh-key.sh
# Production (nlp-sm): CREDENTIAL_GPU_KEY_1_PATH=/root/.ssh/id_rsa
# Target SSH is often port 4204 (not 22) — see docs/SSH_PORTS_AND_PRODUCTION.md
CREDENTIAL_GPU_KEY_1_PATH=/absolute/path/to/credentials/unified_ops_ed25519
# DEFAULT_SSH_PRIVATE_KEY_PATH=/absolute/path/to/credentials/unified_ops_ed25519
SSH_CONNECT_TIMEOUT=15
SSH_COMMAND_TIMEOUT=10
# false = accept new host keys (typical until all targets are known)
SSH_STRICT_HOST_KEYS=false
SSH_GPU_COMMAND_TIMEOUT=30

# Phase 3 — Redis / Celery (default uses local Redis on 6379)
REDIS_URL=redis://127.0.0.1:6379/0
METRICS_COLLECT_INTERVAL_SECONDS=300
# Production nlp-sm: true + Redis + scripts/start-scheduled-collect-nlp-sm.sh
METRICS_SCHEDULED_COLLECT_ENABLED=false

# Phase 4 — alert thresholds
ALERT_MEM_USED_PCT_WARNING=85
ALERT_DISK_USED_PCT_WARNING=85
ALERT_DISK_USED_PCT_CRITICAL=92
ALERT_GPU_TEMP_C_WARNING=85

# GPU product metrics pilot (read-only SSH). Comma-separated IPs, or * for all gpu servers.
GPU_PRODUCT_COLLECT_IPS=81.17.61.148

# Phase 6 — comma-separated systemd units allowed for systemctl_restart (empty = disabled)
ALLOWLIST_RESTART_SERVICES=

# Worktual Gemma (OpenAI-compatible on GPU host)
LLM_MODEL=worktual-gemma
LLM_BASE_URL=http://173.234.75.166:8011/v1
LLM_API_KEY=dummy
LLM_TIMEOUT_SECONDS=120

# Email SSH insights (default on for project=email): queue, services, pflogsumm — no MariaDB.
EMAIL_SSH_INSIGHTS_ENABLED=true
# EMAIL_SSH_INSIGHTS_IPS=82.113.72.84,82.113.72.80,10.180.0.84
# EMAIL_SSH_COMMAND_TIMEOUT=25

# BackupVault SSH insights (read-only): replication, storage, backups, app services.
BACKUPVAULT_SSH_INSIGHTS_ENABLED=true
# Empty or * = all project=backupvault hosts. Pilot example:
# BACKUPVAULT_SSH_INSIGHTS_IPS=10.180.0.119,10.180.0.215,10.180.0.150
# BACKUPVAULT_SSH_COMMAND_TIMEOUT=30
# BACKUPVAULT_BACKUP_PATHS=/backup,/backups,/var/backups,/srv/backupvault
# BACKUPVAULT_APP_SERVICE_UNITS=backupvault,backupvault-worker
# BACKUPVAULT_LOCAL_HEALTH_URLS=http://127.0.0.1:8080/health,http://127.0.0.1:9000/ready

# Infrastructure SSH (project=infrastructure). Read-only systemctl, df, redis-cli, mysql/psql status.
# INFRASTRUCTURE_SSH_INSIGHTS_ENABLED=true
# INFRASTRUCTURE_SSH_INSIGHTS_IPS=
# INFRASTRUCTURE_SSH_COMMAND_TIMEOUT=30
# INFRASTRUCTURE_APP_SERVICE_UNITS=
# INFRASTRUCTURE_LOCAL_HEALTH_URLS=http://127.0.0.1:8001/status,http://127.0.0.1:3000/api/health
# INFRASTRUCTURE_PBX_SERVICE_UNITS=asterisk,freepbx
# INFRASTRUCTURE_SIP_SERVICE_UNITS=kamailio,rtpengine
# INFRASTRUCTURE_REDIS_SERVICE_UNITS=redis,redis-server
# INFRASTRUCTURE_REDIS_CLI_PROBES=default,/var/run/redis/redis.sock,127.0.0.1:6379
# INFRASTRUCTURE_KONG_SERVICE_UNITS=kong,kong-gateway
# INFRASTRUCTURE_GRAFANA_SERVICE_UNITS=grafana-server,grafana

# VoiceMG SSH (project=voicemg). VMG vs STT role from hostname; STT runs nvidia-smi when present.
# VOICEMG_SSH_INSIGHTS_ENABLED=true
# VOICEMG_APP_SERVICE_UNITS=
# VOICEMG_VMG_SERVICE_UNITS=voicemg,ccaas-vmg
# VOICEMG_STT_SERVICE_UNITS=stt,whisper
# VOICEMG_LOCAL_HEALTH_URLS=http://127.0.0.1:8080/health

# Legacy portal metrics — MySQL on AI Insights / server-management (10.180.1.222).
# SSH to that box is port 4204 (NOT 4202). MySQL is usually 3306 — discover first:
#   SERVER_MGMT_SSH_PASSWORD='...' python scripts/discover-legacy-mysql-via-ssh.py
# LEGACY_METRICS_DATABASE_URL=mysql+pymysql://readonly:SECRET@10.180.1.222:3306/information_schema
# Then: python scripts/inspect-legacy-metrics-db.py — set LEGACY_*_DATABASE, table, columns.
# LEGACY_METRICS_SCHEDULED_SYNC_ENABLED=true
# LEGACY_METRICS_SYNC_INTERVAL_SECONDS=300
# LEGACY_AI_INSIGHTS_SYNC_ENABLED=false
# LEGACY_AI_INSIGHTS_DATABASE=ai_servers
# LEGACY_BACKUPVAULT_SYNC_ENABLED=false
# LEGACY_BACKUPVAULT_DATABASE=backupvault
# LEGACY_VOICEMG_SYNC_ENABLED=false
# LEGACY_INFRASTRUCTURE_SYNC_ENABLED=false
# LEGACY_INFRASTRUCTURE_DATABASE=server_inventory
# Live Infrastructure tabs (dashboard / baremetal / Proxmox / VMs) read this DB on page load.
# LEGACY_METRICS_HOST_SERVER_MAP=10.180.0.130:backupvault-130

# Email-management DB (optional read-only). SSH uses inventory IPs; DB uses MariaDB host/port below.
# EMAIL_MGMT_DATABASE_URL=mysql+pymysql://readonly:SECRET@10.180.0.84:3306/email_management
# Run: python scripts/inspect-email-mgmt-db.py — then set EMAIL_MGMT_EVENTS_TABLE and EMAIL_MGMT_COL_*
# EMAIL_MGMT_SCHEDULED_SYNC_ENABLED=true
# EMAIL_MGMT_SYNC_INTERVAL_SECONDS=120
# EMAIL_MGMT_COL_CATEGORY=mail_category
# EMAIL_MGMT_CATEGORY_FILTER=transactional

# Dashboard login (production: set strong JWT_SECRET; never commit passwords)
AUTH_ENABLED=true
JWT_SECRET=generate-a-long-random-string
JWT_EXPIRE_MINUTES=10080
# Optional one-time bootstrap if app_users is empty (prefer scripts/create-admin-user.py on server):
# BOOTSTRAP_ADMIN_EMAIL=you@gmail.com
# BOOTSTRAP_ADMIN_PASSWORD=

# Frontend (optional, for Vite)
# VITE_API_URL=http://localhost:8000

# GPU 165/166: set password on server only (never commit):
# SSH_GPU_PASSWORD='...' python scripts/set-gpu-ssh-password.py
