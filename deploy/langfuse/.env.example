# Copy to deploy/langfuse/.env and replace every CHANGEME before starting.
# Do not set LANGFUSE_EE_LICENSE_KEY. Do not set LANGFUSE_UI_LOGO_* (Enterprise UI branding).
#
#   cp .env.example .env
#   openssl rand -hex 32   # use once for ENCRYPTION_KEY
#   openssl rand -base64 32  # use for NEXTAUTH_SECRET, SALT, and passwords

NEXTAUTH_URL=http://127.0.0.1:3000
NEXTAUTH_SECRET=CHANGEME
SALT=CHANGEME
ENCRYPTION_KEY=CHANGEME

POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=postgres
DATABASE_URL=postgresql://postgres:CHANGEME@postgres:5432/postgres

CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=CHANGEME

REDIS_AUTH=CHANGEME

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=CHANGEME
# These three must be the same value as MINIO_ROOT_PASSWORD.
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=CHANGEME
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=CHANGEME
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=CHANGEME

TELEMETRY_ENABLED=false
LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES=false

# Optional first user and CRM project. Leave blank to sign up in the Langfuse UI.
# LANGFUSE_INIT_ORG_ID=worktual
# LANGFUSE_INIT_ORG_NAME=Worktual
# LANGFUSE_INIT_PROJECT_ID=crm
# LANGFUSE_INIT_PROJECT_NAME=crm
# LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-CHANGEME
# LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-CHANGEME
# LANGFUSE_INIT_USER_EMAIL=admin@worktual.tech
# LANGFUSE_INIT_USER_NAME=Worktual
# LANGFUSE_INIT_USER_PASSWORD=CHANGEME
